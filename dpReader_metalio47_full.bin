<html lang="vi">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>dpReader ยท Truyแปn dแปฏ liแปu & ฤแป“ng bแป</title>
<style>
:root{color-scheme:dark;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#f1f1f5;background:#0b0b10;--red:#ff3c50;--muted:#aaaabb;--line:#292932}

*{box-sizing:border-box}
body{max-width:1100px;margin:24px auto;padding:0 24px 40px;font-size:14px;line-height:1.6;display:grid;grid-template-columns:190px minmax(0,1fr);column-gap:28px}
header{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding:20px 0 24px;margin-bottom:24px}
h1{font-size:30px;line-height:1.2;letter-spacing:-1px;font-weight:500;margin:0}
h2{font-size:19px;line-height:1.3;font-weight:500;margin:0 0 12px}
section{background:#111116;border:1px solid var(--line);border-radius:14px;padding:24px;margin:0 0 20px}
.eyebrow{color:var(--red);font:11px/1.7 ui-monospace,monospace;letter-spacing:1.5px;margin:0 0 9px}
.muted,.hint{color:var(--muted)}
.muted{font-size:12px}
.hint{margin:4px 0 17px;font-size:13px}
.line{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
#storage{margin:0;font-size:13px}
button,input{font:inherit;max-width:100%}
button{min-height:44px;padding:9px 14px;border:1px solid #35353f;border-radius:8px;background:#1a1a22;color:#f1f1f5;cursor:pointer}
button:hover{background:#252530}
button:disabled{opacity:.45;cursor:default}
.primary{background:var(--red);border-color:var(--red);color:#fff}
.primary:hover{background:#e83447}
.danger{color:#ffa2ae}
.tiny{font-size:12px;padding:8px 10px}
input[type=file]{width:100%;padding:24px 16px;border:1px dashed #79323e;border-radius:12px;background:#17121a;color:#c4c4d0}
input::file-selector-button{font:inherit;min-height:44px;padding:8px 12px;margin:0 12px 4px 0;border:1px solid #4b323e;border-radius:8px;background:#34202c;color:#ffe9ed;cursor:pointer}
input[type=text],input[type=password],input[type=url]{width:100%;min-height:44px;padding:10px 12px;background:#191920;color:#f1f1f5;border:1px solid #35353f;border-radius:8px;margin-bottom:12px}
input[type=checkbox],input[type=range]{accent-color:var(--red)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.check-line{display:flex;align-items:center;gap:10px;margin:10px 0 20px;min-height:44px}
.upload .send{margin-top:14px}
.result{min-height:24px;margin:12px 0 0;color:#e4a5b0;overflow-wrap:anywhere}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:14px 0}
#path{overflow-wrap:anywhere;font-size:13px}
ul{list-style:none;padding:0;margin:0}
li{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:65px;padding:13px 0;border-top:1px solid var(--line)}
.entry-name{min-width:0;flex:1;overflow-wrap:anywhere}
.entry-name small{display:block;color:var(--muted);font-size:12px}
.entry-actions{display:flex;flex-wrap:wrap;justify-content:end;gap:6px}
.folder{font-weight:500;text-align:left;border:0;background:none;padding:0;color:#f1f1f5}
.folder:hover{background:none;text-decoration:underline}
.pages{display:flex;gap:8px;align-items:center;justify-content:end;flex-wrap:wrap;margin-top:14px}
dialog{width:min(92vw,440px);border:1px solid #59404d;border-radius:14px;padding:24px;background:#17171e;color:#f1f1f5;box-shadow:0 18px 60px #0008}
dialog::backdrop{background:#0009}
dialog p{color:var(--muted);overflow-wrap:anywhere}
.dialog-actions{display:flex;justify-content:end;gap:8px;margin-top:20px}
.crop-layout{display:flex;align-items:start;gap:22px;flex-wrap:wrap}
.crop-preview{display:block;width:min(100%,240px);height:auto;aspect-ratio:684/1216;border:2px solid #59515e;border-radius:12px;background:#e2e3e0;touch-action:none;cursor:grab}
.crop-preview:active{cursor:grabbing}
.crop-controls{flex:1;min-width:min(100%,200px)}
.crop-controls label{display:block;margin:14px 0 5px}
.crop-controls input[type=range]{width:100%}
.crop-controls .primary{margin-top:16px}
[hidden]{display:none!important}
.portal-tabs{grid-column:1;grid-row:2/4;display:flex;flex-direction:column;gap:7px;border-right:1px solid var(--line);padding-right:18px}
.portal-tabs button{min-width:0;width:100%;text-align:left;padding:12px;border:0;background:transparent;color:#b8b8c6}
.portal-tabs button[aria-selected=true]{background:#ff3c5017;color:#fff;box-shadow:inset 3px 0 var(--red)}
button:focus-visible,input:focus-visible,[role=tabpanel]:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.storage-summary{grid-column:2;padding:15px 20px;margin-bottom:20px}
.storage-summary .hint{font-size:12px;margin:5px 0 0}
main{grid-column:2;min-width:0}
#panel-books .upload{border:1px dashed #79323e;background:radial-gradient(ellipse at 50% 0%,#ff3c5012,transparent 80%),#111116}
.upload.dragging{outline:2px solid var(--red);outline-offset:3px}
@media(max-width:700px){body{display:block;padding:0 14px 32px;margin-top:8px}
header{align-items:start;flex-wrap:wrap;padding-bottom:20px}
h1{font-size:27px}
section{padding:19px 16px}
.portal-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;padding:0 0 16px;border:0}
.portal-tabs button{text-align:center;padding:10px 4px;font-size:12px}
.portal-tabs button[aria-selected=true]{box-shadow:inset 0 -2px var(--red)}
.entry-actions{width:100%;justify-content:start}
li{flex-wrap:wrap}
.form-grid{grid-template-columns:1fr}
input,button{min-height:44px}
}

</style>
<header><div><p class="eyebrow">dpReader / TRUYแป€N Dแปฎ LIแปU</p><h1>Chuyแปn mแปt cuแป‘n sรกch.<br>Mแป mแปt thแบฟ giแปi.</h1></div><span class="muted">Metalio E-ink 4.7"</span></header>
<section class="storage-summary" aria-label="Trแบกng thรกi lฦฐu trแปฏ"><p id="storage" role="status">ฤang ฤ‘แปc trแบกng thรกi thiแบฟt bแปโ€ฆ</p><p class="hint">Giแปฏ dpReader แป mร n hรฌnh truyแปn dแปฏ liแปu. Tแปp tแบฃi lรชn sแบฝ ฤ‘ฦฐแปฃc lฦฐu vร o thฦฐ mแปฅc tฦฐฦกng แปฉng.</p></section>
<nav class="portal-tabs" role="tablist" aria-label="Chแปฉc nฤng truyแปn dแปฏ liแปu">
<button type="button" role="tab" id="tab-books" aria-controls="panel-books" aria-selected="true" tabindex="0">Sรกch</button>
<button type="button" role="tab" id="tab-files" aria-controls="panel-files" aria-selected="false" tabindex="-1">Thแบป nhแป</button>
<button type="button" role="tab" id="tab-dictionaries" aria-controls="panel-dictionaries" aria-selected="false" tabindex="-1">Tแปซ ฤ‘iแปn</button>
<button type="button" role="tab" id="tab-fonts" aria-controls="panel-fonts" aria-selected="false" tabindex="-1">Phรดng chแปฏ</button>
<button type="button" role="tab" id="tab-images" aria-controls="panel-images" aria-selected="false" tabindex="-1">Hรฌnh แบฃnh</button>
<button type="button" role="tab" id="tab-sync" aria-controls="panel-sync" aria-selected="false" tabindex="-1">ฤแป“ng bแป</button>
<button type="button" role="tab" id="tab-personal" aria-controls="panel-personal" aria-selected="false" tabindex="-1">Cรก nhรขn</button>
</nav>
<main>
<div id="panel-books" role="tabpanel" aria-labelledby="tab-books" tabindex="0">
<section class="upload" data-kind="book"><h2>Truyแปn sรกch vร o dpReader</h2><p class="hint">Kรฉo thแบฃ hoแบทc chแปn tแปp EPUB, TXT โ’ thฦฐ mแปฅc books. Sแบฝ hแปi xรกc nhแบญn nแบฟu trรนng tรชn.</p><input type="file" accept=".epub,.txt" multiple aria-label="Chแปn sรกch"><button class="primary send" type="button">Tแบฃi lรชn thฦฐ mแปฅc books</button><p class="result" role="status"></p></section>
</div>
<div id="panel-files" role="tabpanel" aria-labelledby="tab-files" tabindex="0" hidden>
<section id="browser"><div class="line"><h2>Duyแปt thแบป nhแป TF</h2><button id="refresh" class="tiny" type="button">Lร m mแปi</button></div>
<div class="toolbar"><button id="up" class="tiny" type="button">Thฦฐ mแปฅc cha</button><span id="path">/</span><button id="newFolder" class="tiny" type="button">Tแบกo thฦฐ mแปฅc mแปi</button></div>
<div class="upload" data-kind="file"><p class="hint">Mแป thฦฐ mแปฅc ฤ‘รญch trฦฐแปc rแป“i chแปn tแปp ฤ‘แป tแบฃi lรชn. Hแป— trแปฃ mแปi ฤ‘แปnh dแบกng vร  giแปฏ nguyรชn tรชn gแป‘c.</p><input type="file" multiple aria-label="Chแปn tแปp bแบฅt kแปณ"><button class="primary send" type="button">Tแบฃi tแปp vร o thฦฐ mแปฅc hiแปn tแบกi</button><p class="result" role="status"></p></div>
<p id="listState" class="hint" role="status"></p><ul id="entries"></ul>
<div class="pages"><button id="previous" class="tiny" type="button">Trang trฦฐแปc</button><span id="pageState" class="muted"></span><button id="next" class="tiny" type="button">Trang sau</button></div></section>
</div>
<div id="panel-dictionaries" role="tabpanel" aria-labelledby="tab-dictionaries" tabindex="0" hidden>
<section id="dictionaryUpload"><h2>Thรชm tแปซ ฤ‘iแปn offline</h2><p class="hint">Chแปn folder bแป StarDict hoแบทc chแปn ฤ‘แปง bแป tแปp cรนng tรชn: .ifo + .idx/.idx.gz + .dict/.dict.dz (cรณ thแป kรจm .syn). Lฦฐu vร o /dict/tรชn bแป/, khรดng cแบงn giแบฃi nรฉn trฦฐแปc.</p>
<label for="dictionaryFolder">Chแปn folder tแปซ ฤ‘iแปn</label><input id="dictionaryFolder" type="file" webkitdirectory multiple aria-label="Chแปn folder bแป tแปซ ฤ‘iแปn">
<p class="hint">Nแบฟu trรฌnh duyแปt khรดng chแปn ฤ‘ฦฐแปฃc folder, dรนng phแบงn chแปn tแปp bรชn dฦฐแปi.</p>
<label for="dictionaryName">Tรชn thฦฐ mแปฅc bแป tแปซ ฤ‘iแปn</label><input id="dictionaryName" type="text" maxlength="100" placeholder="Vรญ dแปฅ: Anh-Viet">
<input id="dictionaryFiles" type="file" accept=".ifo,.idx,.gz,.dict,.dz,.syn" multiple aria-label="Chแปn cรกc tแปp cแปงa bแป tแปซ ฤ‘iแปn">
<button id="dictionarySend" class="primary" type="button">Tแบฃi tแปซ ฤ‘iแปn vร o thแบป nhแป</button><button id="dictionaryBrowse" type="button">Mแป thฦฐ mแปฅc dict</button><p id="dictionaryResult" class="result" role="status"></p></section>
</div>
<div id="panel-fonts" role="tabpanel" aria-labelledby="tab-fonts" tabindex="0" hidden>
<section class="upload" data-kind="font"><h2>Tแบฃi phรดng chแปฏ</h2><p class="hint">TTF, OTF โ’ thฦฐ mแปฅc fonts. Sau khi tแบฃi lรชn cรณ thแป chแปn trong cร i ฤ‘แบทt phรดng chแปฏ khi ฤ‘แปc.</p><input type="file" accept=".ttf,.otf" multiple aria-label="Chแปn phรดng chแปฏ"><button class="primary send" type="button">Tแบฃi lรชn thฦฐ mแปฅc fonts</button><p class="result" role="status"></p></section>
</div>
<div id="panel-images" role="tabpanel" aria-labelledby="tab-images" tabindex="0" hidden>
<section class="upload" data-kind="picture"><h2>Tแบฃi hรฌnh แบฃnh</h2><p class="hint">JPG, JPEG, PNG โ’ thฦฐ mแปฅc pictures. Cรณ thแป chแปn lร m hรฌnh nแปn khรณa trรชn thiแบฟt bแป.</p><input type="file" accept=".jpg,.jpeg,.png" multiple aria-label="Chแปn hรฌnh แบฃnh"><button class="primary send" type="button">Tแบฃi lรชn thฦฐ mแปฅc pictures</button><p class="result" role="status"></p></section>
<section id="wallpaper"><h2>Cร i hรฌnh nแปn mร n hรฌnh khรณa</h2><p class="hint">Chแปn แบฃnh tแปซ ฤ‘iแปn thoแบกi/mรกy tรญnh, kรฉo khung cแบฏt vร  chแปnh thu phรณng. Tแปฑ ฤ‘แปng ฤ‘แบทt lร m mร n hรฌnh khรณa sau khi tแบฃi lรชn.</p><div class="crop-layout"><canvas id="cropPreview" class="crop-preview" width="342" height="608" aria-label="Xem trฦฐแปc cแบฏt แบฃnh 684 ร— 1216"></canvas><div class="crop-controls"><input id="wallpaperFile" type="file" accept="image/*" aria-label="Chแปn แบฃnh mร n hรฌnh khรณa"><label for="cropZoom">Thu phรณng แบฃnh</label><input id="cropZoom" type="range" min="1" max="3" step="0.01" value="1" aria-label="Thu phรณng แบฃnh"><p class="muted">ฤแป phรขn giแบฃi chuแบฉn: 684 ร— 1216 px. Kรฉo trong khung ฤ‘แป cฤn chแปnh.</p><button id="cropReset" type="button">Cฤn giแปฏa lแบกi</button><button id="wallpaperSend" class="primary" type="button" disabled>Cแบฏt & ฤแบทt lร m mร n hรฌnh khรณa</button><p id="wallpaperResult" class="result" role="status">Vui lรฒng chแปn แบฃnh trฦฐแปc</p></div></div></section>
</div>
<div id="panel-sync" role="tabpanel" aria-labelledby="tab-sync" tabindex="0" hidden>
<section id="syncSettings"><h2>ฤแป“ng bแป KOSync & Thฦฐ viแปn OPDS</h2><p class="hint">Cแบฅu hรฌnh mรกy chแปง ฤ‘แป“ng bแป tiแบฟn ฤ‘แป ฤ‘แปc KOReader (KOSync) vร  kho sรกch trแปฑc tuyแบฟn OPDS (Calibre-Web).</p>
<label class="muted">Mรกy chแปง KOSync (mแบทc ฤ‘แปnh: https://sync.vreader.cloud)</label>
<input id="kosyncUrl" type="text" maxlength="127" placeholder="https://sync.vreader.cloud">
<div class="form-grid">
<input id="kosyncUser" type="text" maxlength="63" placeholder="Tร i khoแบฃn KOSync">
<input id="kosyncPass" type="password" maxlength="63" placeholder="Mแบญt khแบฉu KOSync (ฤ‘แป trแป‘ng nแบฟu giแปฏ nguyรชn)">
</div>
<label class="check-line"><input id="kosyncAuto" type="checkbox"> Tแปฑ ฤ‘แปng ฤ‘แป“ng bแป tiแบฟn ฤ‘แป khi mแป/ฤ‘รณng sรกch</label>
<label class="muted">Danh mแปฅc OPDS (mแบทc ฤ‘แปnh: https://sach.vreader.cloud:8443/opds)</label>
<input id="opdsUrl" type="text" maxlength="127" placeholder="https://sach.vreader.cloud:8443/opds">
<div class="form-grid">
<input id="opdsUser" type="text" maxlength="63" placeholder="Tร i khoแบฃn OPDS (nแบฟu cรณ)">
<input id="opdsPass" type="password" maxlength="63" placeholder="Mแบญt khแบฉu OPDS (nแบฟu cรณ)">
</div>
<button id="syncSave" class="primary" type="button">Lฦฐu cแบฅu hรฌnh KOSync & OPDS</button>
<p id="syncResult" class="result" role="status">ฤang tแบฃi cแบฅu hรฌnh ฤ‘แป“ng bแปโ€ฆ</p></section>
</div>
<div id="panel-personal" role="tabpanel" aria-labelledby="tab-personal" tabindex="0" hidden>
<section id="signatureSettings"><h2>Chแปฏ kรฝ thanh trแบกng thรกi</h2><p class="hint">Hiแปn thแป แป chรญnh giแปฏa phรญa trรชn mร n hรฌnh E-ink. ฤแป trแป‘ng vร  lฦฐu nแบฟu muแป‘n แบฉn.</p><input id="signatureText" type="text" maxlength="95" aria-label="Chแปฏ kรฝ thanh trแบกng thรกi" placeholder="Nhแบญp chแปฏ kรฝ cแปงa bแบกn"><button id="signatureSave" class="primary" type="button">Lฦฐu chแปฏ kรฝ</button><p id="signatureResult" class="result" role="status">ฤang ฤ‘แปc chแปฏ kรฝโ€ฆ</p></section>
</div>
</main>
<dialog id="editor"><h2 id="editorTitle"></h2><p id="editorDescription"></p><input id="editorName" type="text" maxlength="238" aria-label="Tรชn mแปi"><div class="dialog-actions"><button id="editorCancel" type="button">Hแปงy</button><button id="editorConfirm" class="primary" type="button">Xรกc nhแบญn</button></div></dialog>
<script>
const $=id=>document.getElementById(id);
let policy=null,busy=false,path='',page=0,pages=0,editorAction=null;
const portalTabs=Array.from(document.querySelectorAll('[role="tab"]'));
function selectPortalTab(tab,focus=false){
 if(busy||!portalTabs.includes(tab))return;
 for(const item of portalTabs){const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;$(item.getAttribute('aria-controls')).hidden=!active}
 if(focus)tab.focus();
}
portalTabs.forEach((tab,index)=>{
 tab.onclick=()=>selectPortalTab(tab);
 tab.onkeydown=event=>{
  let next;
  if(event.key==='ArrowRight')next=(index+1)%portalTabs.length;
  else if(event.key==='ArrowLeft')next=(index+portalTabs.length-1)%portalTabs.length;
  else if(event.key==='Home')next=0;
  else if(event.key==='End')next=portalTabs.length-1;
  else return;
  event.preventDefault();selectPortalTab(portalTabs[next],true);
 };
});
const size=n=>n>=1048576?(n/1048576).toFixed(1)+' MB':n>=1024?Math.ceil(n/1024)+' KB':n+' B';
const join=(dir,name)=>dir?dir+'/'+name:name;
async function request(url,options){const response=await fetch(url,{cache:'no-store',...options});let body;try{body=await response.json()}catch{throw Error('Phแบฃn hแป“i tแปซ thiแบฟt bแป khรดng hแปฃp lแป, vui lรฒng thแปญ lแบกi')}return {status:response.status,body}}
function lock(value){busy=value;document.querySelectorAll('button,input[type=file],input[type=range],#dictionaryName,#signatureText,#kosyncUrl,#kosyncUser,#kosyncPass,#kosyncAuto,#opdsUrl,#opdsUser,#opdsPass').forEach(el=>{if(el.id!=='editorCancel')el.disabled=value});if(!value){$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages;$('wallpaperSend').disabled=!cropImage}}
async function info(){const r=await request('/info');if(r.status!==200)throw Error(r.body.error||'Khรดng thแป ฤ‘แปc trแบกng thรกi lฦฐu trแปฏ');policy=r.body;$('storage').textContent=(policy.is_flash?'Chฦฐa nhแบญn thแบป nhแป TF':'Thแบป nhแป TF sแบตn sร ng')+' ยท Cรฒn trแป‘ng '+size(policy.free_bytes);if(policy.is_flash){$('browser').hidden=true;$('dictionaryUpload').hidden=true;document.querySelectorAll('.upload').forEach(el=>el.hidden=true);$('storage').textContent='Khรดng phรกt hiแปn thแบป nhแป TF, vui lรฒng lแบฏp thแบป nhแป rแป“i mแป lแบกi trang truyแปn dแปฏ liแปu'}}
async function loadDirectory(){if(policy.is_flash)return;const r=await request('/files?'+(path?'path='+encodeURIComponent(path)+'&':'')+'page='+page);if(r.status!==200)throw Error(r.body.error||'Khรดng thแป ฤ‘แปc thฦฐ mแปฅc');pages=r.body.pages;if(page>=pages&&page){page=0;return loadDirectory()}$('path').textContent='/'+path;$('listState').textContent=r.body.total+' mแปฅc';$('pageState').textContent=(pages?page+1:0)+' / '+pages;$('entries').replaceChildren();for(const item of r.body.items){const row=document.createElement('li'),name=document.createElement('div'),actions=document.createElement('div'),detail=document.createElement('small');name.className='entry-name';actions.className='entry-actions';detail.textContent=item.directory?'Thฦฐ mแปฅc':size(item.size);if(item.directory){const open=document.createElement('button');open.className='folder';open.textContent='โ–ฑ  '+item.name;open.onclick=()=>{path=join(path,item.name);page=0;loadDirectory().catch(showError)};name.append(open)}else{name.textContent=item.name}name.append(detail);for(const action of ['rename','copy','delete']){const button=document.createElement('button');button.className='tiny'+(action==='delete'?' danger':'');button.textContent={rename:'ฤแป•i tรชn',copy:'Nhรขn bแบฃn',delete:'Xรณa'}[action];button.onclick=()=>openEditor(action,item);actions.append(button)}row.append(name,actions);$('entries').append(row)}$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages}
function showError(error){$('listState').textContent=error.message||String(error)}
function openEditor(action,item){if(busy)return;const source=item?join(path,item.name):path;editorAction={action,source,item};$('editorTitle').textContent={rename:'ฤแป•i tรชn',copy:'Nhรขn bแบฃn',delete:'Xรณa',mkdir:'Tแบกo thฦฐ mแปฅc mแปi'}[action];$('editorDescription').textContent=action==='delete'?source+(item.directory?' (sแบฝ xรณa toร n bแป tแปp bรชn trong)':''):'Vแป trรญ: /'+path;$('editorName').hidden=action==='delete';$('editorName').value=action==='copy'?(item.directory?item.name+' (Bแบฃn sao)':item.name.replace(/(\.[^.]+)?$/,' (Bแบฃn sao)$1')):item?item.name:'';$('editorConfirm').textContent=action==='delete'?'Xรกc nhแบญn xรณa':'Lฦฐu';$('editorConfirm').classList.toggle('danger',action==='delete');$('editor').showModal();if(action!=='delete')$('editorName').focus()}
$('editorCancel').onclick=()=>$('editor').close();
$('editorConfirm').onclick=async()=>{if(!editorAction)return;const {action,source}=editorAction;const name=$('editorName').value.trim();if(action!=='delete'&&(!name||name==='.'||name==='..'||/[\\/:*?"<>|]/.test(name))){$('editorDescription').textContent='Tรชn khรดng ฤ‘ฦฐแปฃc chแปฉa dแบฅu gแบกch chรฉo hoแบทc kรฝ tแปฑ ฤ‘แบทc biแปt';return}const target=action==='delete'?'':join(path,name);if(action!=='delete'&&new TextEncoder().encode(target).length>238){$('editorDescription').textContent='ฤฦฐแปng dแบซn quรก dร i, vui lรฒng rรบt ngแบฏn tรชn';return}const payload={action,path:source,...(action==='delete'?{}:{target})};$('editorConfirm').disabled=true;try{const r=await request('/files',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(r.status!==200)throw Error(r.body.error||'Thao tรกc thแบฅt bแบกi');$('editor').close();await info();await loadDirectory()}catch(error){$('editorDescription').textContent=error.message}finally{$('editorConfirm').disabled=false}};
$('refresh').onclick=()=>loadDirectory().catch(showError);
$('up').onclick=()=>{if(!path)return;path=path.includes('/')?path.slice(0,path.lastIndexOf('/')):'';page=0;loadDirectory().catch(showError)};
$('newFolder').onclick=()=>openEditor('mkdir');
$('previous').onclick=()=>{if(page){--page;loadDirectory().catch(showError)}};
$('next').onclick=()=>{if(page+1<pages){++page;loadDirectory().catch(showError)}};
async function loadSyncConfig(){const r=await request('/sync-config');if(r.status!==200)throw Error(r.body.error||'Khรดng thแป ฤ‘แปc cแบฅu hรฌnh KOSync/OPDS');$('kosyncUrl').value=r.body.kosync_url||'https://sync.vreader.cloud';$('kosyncUser').value=r.body.kosync_user||'';$('kosyncPass').value='';$('kosyncAuto').checked=!!r.body.kosync_auto;$('opdsUrl').value=r.body.opds_url||'https://sach.vreader.cloud:8443/opds';$('opdsUser').value=r.body.opds_user||'';$('opdsPass').value='';$('syncResult').textContent='Sแบตn sร ng chแปnh sแปญa cแบฅu hรฌnh KOSync & OPDS'}
$('syncSave').onclick=async()=>{if(busy)return;const result=$('syncResult');lock(true);try{result.textContent='ฤang lฦฐu cแบฅu hรฌnhโ€ฆ';const payload={kosync_url:$('kosyncUrl').value.trim(),kosync_user:$('kosyncUser').value.trim(),kosync_pass:$('kosyncPass').value,kosync_auto:$('kosyncAuto').checked?1:0,opds_url:$('opdsUrl').value.trim(),opds_user:$('opdsUser').value.trim(),opds_pass:$('opdsPass').value};const r=await request('/sync-config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(r.status!==200)throw Error(r.body.error||'Lฦฐu cแบฅu hรฌnh thแบฅt bแบกi');$('kosyncPass').value='';$('opdsPass').value='';result.textContent='ฤรฃ lฦฐu cแบฅu hรฌnh KOSync & OPDS thร nh cรดng'}catch(error){result.textContent=error.message}finally{lock(false)}};
loadSyncConfig().catch(error=>$('syncResult').textContent=error.message);
async function loadSignature(){const r=await request('/signature');if(r.status!==200)throw Error(r.body.error||'Khรดng thแป ฤ‘แปc chแปฏ kรฝ');$('signatureText').value=r.body.signature||'';$('signatureResult').textContent='Cรณ thแป chแปnh sแปญa vร  lฦฐu chแปฏ kรฝ'}
$('signatureSave').onclick=async()=>{if(busy)return;const text=$('signatureText').value,result=$('signatureResult');if(new TextEncoder().encode(text).length>95){result.textContent='Chแปฏ kรฝ quรก dร i (tแป‘i ฤ‘a 95 byte)';return}if(/[\x00-\x1f\x7f\u2028\u2029]/.test(text)){result.textContent='Chแปฏ kรฝ khรดng ฤ‘ฦฐแปฃc chแปฉa kรฝ tแปฑ xuแป‘ng dรฒng';return}lock(true);try{result.textContent='ฤang lฦฐuโ€ฆ';const r=await request('/signature',{method:'POST',headers:{'Content-Type':'text/plain; charset=utf-8'},body:text});if(r.status!==200)throw Error(r.body.error||'Lฦฐu thแบฅt bแบกi');result.textContent=text?'ฤรฃ lฦฐu chแปฏ kรฝ lรชn thanh trแบกng thรกi dpReader':'ฤรฃ xรณa chแปฏ kรฝ'}catch(error){result.textContent=error.message}finally{lock(false)}};
loadSignature().catch(error=>$('signatureResult').textContent=error.message);
function dictionaryPlan(files,folderName){
 const planned=[],groups=new Map(),seen=new Set();
 const validPart=part=>part&&part!=='.'&&part!=='..'&&!/[\\/:*?"<>|\x00-\x1f]/.test(part)&&!/[. ]$/.test(part)&&!part.startsWith('.');
 for(const file of files){
  const relative=file.webkitRelativePath||join(folderName,file.name),parts=relative.split('/');
  if(parts[0]==='dict')parts.shift();
  if(!/\.(ifo|idx(?:\.gz)?|dict(?:\.dz)?|syn)$/.test(file.name))continue;
  if(parts.length!==2||parts.some(part=>!validPart(part)))throw Error('Mแป—i bแป cแบงn mแปt folder trแปฑc tiแบฟp trong dict; tรชn khรดng ฤ‘ฦฐแปฃc chแปฉa ฤ‘ฦฐแปng dแบซn lแบก');
  const target='dict/'+parts.join('/');
  if(new TextEncoder().encode(target).length>238)throw Error('ฤฦฐแปng dแบซn bแป tแปซ ฤ‘iแปn quรก dร i');
  if(!file.size)throw Error('Tแปp tแปซ ฤ‘iแปn rแป—ng: '+file.name);
  const folded=target.toLowerCase();if(seen.has(folded))throw Error('Tแปp bแป trรนng tรชn: '+file.name);seen.add(folded);
  const suffix=file.name.match(/\.(ifo|idx(?:\.gz)?|dict(?:\.dz)?|syn)$/)[1];
  const base=parts[0]+'/'+file.name.slice(0,-suffix.length-1);
  if(!groups.has(base))groups.set(base,new Set());groups.get(base).add(suffix.split('.')[0]);
  planned.push({file,target,folder:'dict/'+parts[0]});
 }
 if(!planned.length)throw Error('Vui lรฒng chแปn folder hoแบทc ฤ‘แปง bแป tแปp StarDict');
 for(const [base,types] of groups)if(!['ifo','idx','dict'].every(type=>types.has(type)))throw Error('Thiแบฟu bแป ba .ifo + .idx/.idx.gz + .dict/.dict.dz: '+base);
 return planned;
}
async function ensureDictionaryFolder(target){
 const parent=target.includes('/')?target.slice(0,target.lastIndexOf('/')):'';
 const r=await request('/files',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'mkdir',path:parent,target})});
 if(r.status===200)return;
 if(r.status===409){const check=await request('/files?path='+encodeURIComponent(target)+'&page=0');if(check.status===200)return;}
 throw Error(r.body.error||'Khรดng tแบกo ฤ‘ฦฐแปฃc thฦฐ mแปฅc '+target);
}
$('dictionaryFolder').onchange=()=>{$('dictionaryFiles').value=''};
$('dictionaryFiles').onchange=()=>{$('dictionaryFolder').value=''};
$('dictionaryBrowse').onclick=async()=>{if(busy)return;try{await ensureDictionaryFolder('dict');path='dict';page=0;selectPortalTab($('tab-files'));await loadDirectory()}catch(error){$('dictionaryResult').textContent=error.message}};
$('dictionarySend').onclick=async()=>{
 if(busy)return;const result=$('dictionaryResult');
 if(!policy||policy.is_flash){result.textContent='Vui lรฒng gแบฏn thแบป nhแป TF trฦฐแปc';return}
 let planned;try{const files=$('dictionaryFolder').files.length?[...$('dictionaryFolder').files]:[...$('dictionaryFiles').files];planned=dictionaryPlan(files,$('dictionaryName').value.trim());if(planned.reduce((sum,item)=>sum+item.file.size,0)>policy.free_bytes)throw Error('Thแบป nhแป TF khรดng ฤ‘แปง dung lฦฐแปฃng trแป‘ng')}catch(error){result.textContent=error.message;return}
 lock(true);let saved=0;
 try{
  await ensureDictionaryFolder('dict');
  for(const folder of new Set(planned.map(item=>item.folder)))await ensureDictionaryFolder(folder);
  // Publish metadata last so an interrupted fresh upload is not offered as a complete dictionary.
  planned.sort((a,b)=>Number(a.target.endsWith('.ifo'))-Number(b.target.endsWith('.ifo')));
  for(const {file,target} of planned){
   const url='/file-upload?path='+encodeURIComponent(target);
   let response=await upload(file,url,(done,total,elapsed)=>result.textContent=uploadProgress('/'+target,done,total,elapsed));
   if(response.status===409&&confirm('Tแปp tแปซ ฤ‘iแปn ฤ‘รฃ tแป“n tแบกi, ghi ฤ‘รจ?\n/'+target))response=await upload(file,url+'&overwrite=1',(done,total,elapsed)=>result.textContent=uploadProgress('/'+target,done,total,elapsed));
   if(response.status!==200)throw Error(response.body.error||'Khรดng tแบฃi ฤ‘ฦฐแปฃc '+file.name);
   ++saved;
  }
  result.textContent='ฤรฃ lฦฐu '+saved+' tแปp trong /dict. Cรณ thแป mแป sรกch ฤ‘แป tra offline.';
  await info();if(path==='dict'||path.startsWith('dict/'))await loadDirectory();
 }catch(error){result.textContent='ฤรฃ lฦฐu '+saved+'/'+planned.length+' tแปp ยท '+error.message+' ยท Chแปn lแบกi ฤ‘แปง bแป ฤ‘แป thแปญ lแบกi'}finally{lock(false)}
};
function transferRate(bytes,elapsed){const seconds=Math.max(elapsed,1)/1000;return (bytes/seconds/1000).toFixed(0)+' KB/s ยท '+seconds.toFixed(1)+' giรขy'}
function uploadProgress(name,done,total,elapsed){return (done>=total?'ฤang chแป thiแบฟt bแป lฦฐu ':'ฤang tแบฃi lรชn ')+name+' ยท '+size(done)+' / '+size(total)+' ยท '+transferRate(done,elapsed)}
function upload(file,url,onProgress){return new Promise((resolve,reject)=>{
 const xhr=new XMLHttpRequest();xhr.open('PUT',url);
 const start=performance.now();let loaded=0,total=file.size;
 const paint=()=>onProgress(loaded,total,performance.now()-start);
 const timer=setInterval(paint,1000);
 xhr.upload.onprogress=e=>{loaded=e.loaded;total=e.total||file.size;paint()};
 xhr.onload=()=>{clearInterval(timer);try{resolve({status:xhr.status,body:JSON.parse(xhr.responseText),elapsed:performance.now()-start})}catch{reject(Error('Phแบฃn hแป“i khรดng hแปฃp lแป, vui lรฒng kiแปm tra xem tแปp ฤ‘รฃ ฤ‘ฦฐแปฃc lฦฐu chฦฐa'))}};
 xhr.onerror=()=>{clearInterval(timer);reject(Error('Mแบฅt kแบฟt nแป‘i, vui lรฒng giแปฏ mร n hรฌnh truyแปn dแปฏ liแปu trรชn mรกy vร  kiแปm tra Wi-Fi'))};
 xhr.onabort=()=>{clearInterval(timer);reject(Error('ฤรฃ hแปงy tแบฃi lรชn'))};
 try{xhr.send(file)}catch(error){clearInterval(timer);reject(error)}
})}
const types={file:{re:null,url:'/file-upload',limit:0},book:{re:/\.(epub|txt)$/i,url:'/upload',limit:0},font:{re:/\.(ttf|otf)$/i,url:'/font-upload',limit:33554432},picture:{re:/\.(jpg|jpeg|png)$/i,url:'/image-upload',limit:20971520}};
const cropWidth=684,cropHeight=1216;
let cropImage=null,cropZoom=1,cropX=0,cropY=0,cropPointer=null;
function cropScale(){return cropImage?Math.max(cropWidth/cropImage.naturalWidth,cropHeight/cropImage.naturalHeight)*cropZoom:1}
function clampCrop(){if(!cropImage)return;const width=cropImage.naturalWidth*cropScale(),height=cropImage.naturalHeight*cropScale();cropX=Math.min(0,Math.max(cropWidth-width,cropX));cropY=Math.min(0,Math.max(cropHeight-height,cropY))}
function drawCrop(canvas){const ctx=canvas.getContext('2d');ctx.setTransform(canvas.width/cropWidth,0,0,canvas.height/cropHeight,0,0);ctx.fillStyle='#f4f4f2';ctx.fillRect(0,0,cropWidth,cropHeight);if(cropImage)ctx.drawImage(cropImage,cropX,cropY,cropImage.naturalWidth*cropScale(),cropImage.naturalHeight*cropScale());else{ctx.fillStyle='#777d77';ctx.font='32px sans-serif';ctx.textAlign='center';ctx.fillText('684 ร— 1216',cropWidth/2,cropHeight/2)}}
function resetCrop(){if(!cropImage)return;cropZoom=1;$('cropZoom').value='1';cropX=(cropWidth-cropImage.naturalWidth*cropScale())/2;cropY=(cropHeight-cropImage.naturalHeight*cropScale())/2;clampCrop();drawCrop($('cropPreview'))}
$('wallpaperFile').onchange=()=>{const file=$('wallpaperFile').files[0];cropImage=null;$('wallpaperSend').disabled=true;if(!file){drawCrop($('cropPreview'));return}const url=URL.createObjectURL(file),image=new Image();$('wallpaperResult').textContent='ฤang ฤ‘แปc แบฃnhโ€ฆ';image.onload=()=>{URL.revokeObjectURL(url);if(!image.naturalWidth||!image.naturalHeight){$('wallpaperResult').textContent='Kรญch thฦฐแปc แบฃnh khรดng hแปฃp lแป';return}cropImage=image;resetCrop();$('wallpaperSend').disabled=false;$('wallpaperResult').textContent='Kรฉo แบฃnh vร  chแปnh thu phรณng rแป“i nhแบฅn tแบฃi lรชn'};image.onerror=()=>{URL.revokeObjectURL(url);$('wallpaperResult').textContent='Khรดng thแป ฤ‘แปc แบฃnh nร y, vui lรฒng chแปn แบฃnh khรกc'};image.src=url};
$('cropZoom').oninput=()=>{if(!cropImage)return;const next=Number($('cropZoom').value),ratio=next/cropZoom;cropX=cropWidth/2-(cropWidth/2-cropX)*ratio;cropY=cropHeight/2-(cropHeight/2-cropY)*ratio;cropZoom=next;clampCrop();drawCrop($('cropPreview'))};
$('cropReset').onclick=resetCrop;
$('cropPreview').onpointerdown=event=>{if(!cropImage||busy)return;cropPointer={id:event.pointerId,x:event.clientX,y:event.clientY};$('cropPreview').setPointerCapture(event.pointerId)};
$('cropPreview').onpointermove=event=>{if(!cropPointer||cropPointer.id!==event.pointerId)return;const ratio=cropWidth/$('cropPreview').getBoundingClientRect().width;cropX+=(event.clientX-cropPointer.x)*ratio;cropY+=(event.clientY-cropPointer.y)*ratio;cropPointer.x=event.clientX;cropPointer.y=event.clientY;clampCrop();drawCrop($('cropPreview'))};
$('cropPreview').onpointerup=$('cropPreview').onpointercancel=()=>{cropPointer=null};
$('wallpaperSend').onclick=async()=>{if(!cropImage||busy)return;const result=$('wallpaperResult');if(!policy||policy.is_flash){result.textContent='Thiแบฟt bแป chฦฐa kแบฟt nแป‘i hoแบทc thแบป TF chฦฐa sแบตn sร ng';return}lock(true);try{result.textContent='ฤang tแบกo hรฌnh nแปn 684 ร— 1216โ€ฆ';const canvas=document.createElement('canvas');canvas.width=cropWidth;canvas.height=cropHeight;drawCrop(canvas);let blob=null;for(const quality of [0.86,0.72,0.56,0.42]){blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));if(blob&&blob.size<=2097152)break}if(!blob)throw Error('Trรฌnh duyแปt khรดng thแป tแบกo แบฃnh cแบฏt');if(blob.size>2097152)throw Error('แบขnh vแบซn quรก lแปn, vui lรฒng chแปn แบฃnh khรกc');if(blob.size>policy.free_bytes)throw Error('Thแบป nhแป TF khรดng ฤ‘แปง dung lฦฐแปฃng');const name='dpreader-wallpaper-'+Date.now()+'.jpg';const url='/image-upload?name='+encodeURIComponent(name)+'&wallpaper=1';const response=await upload(blob,url,(done,total,elapsed)=>result.textContent=uploadProgress('Hรฌnh nแปn',done,total,elapsed));if(response.status!==200)throw Error(response.body.error||'Tแบฃi hรฌnh nแปn thแบฅt bแบกi');result.textContent='ฤรฃ ฤ‘แบทt lร m hรฌnh nแปn mร n hรฌnh khรณa';await info();if(path==='pictures')await loadDirectory()}catch(error){result.textContent=error.message}finally{lock(false)}};
drawCrop($('cropPreview'));
async function sendFiles(section){
 if(busy||!policy||policy.is_flash)return;
 const kind=section.dataset.kind,config=types[kind],files=[...section.querySelector('input').files],result=section.querySelector('.result'),destination=path;
 if(!files.length){result.textContent='Vui lรฒng chแปn tแปp trฦฐแปc';return}
 lock(true);
 let saved=0,failed=0;
 try{for(const file of files){try{
  if(config.re&&(!config.re.test(file.name)||file.name.startsWith('.')))throw Error('ฤแปnh dแบกng tแปp khรดng hแป— trแปฃ');
  if(kind!=='file'&&!file.size)throw Error('Tแปp rแป—ng');
  if((config.limit&&file.size>config.limit)||(kind==='book'&&policy.file_limit&&file.size>policy.file_limit))throw Error('Kรญch thฦฐแปc tแปp vฦฐแปฃt quรก giแปi hแบกn');
  if(file.size>policy.free_bytes)throw Error('Thแบป nhแป TF khรดng ฤ‘แปง dung lฦฐแปฃng trแป‘ng');
  const target=join(destination,file.name);
  if(kind==='file'&&new TextEncoder().encode(target).length>238)throw Error('ฤฦฐแปng dแบซn quรก dร i, vui lรฒng rรบt ngแบฏn tรชn tแปp');
  const shown=kind==='file'?'/'+target:file.name;
  result.textContent='ฤang tแบฃi lรชn '+shown;
  const url=config.url+(kind==='file'?'?path='+encodeURIComponent(target):'?name='+encodeURIComponent(file.name));
  let response=await upload(file,url,(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status===409&&confirm('Tแปp cรนng tรชn ฤ‘รฃ tแป“n tแบกi, bแบกn cรณ muแป‘n ghi ฤ‘รจ?\n'+shown))response=await upload(file,url+'&overwrite=1',(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status!==200)throw Error(response.body.error||'Tแบฃi lรชn thแบฅt bแบกi');
  ++saved;result.textContent='ฤรฃ lฦฐu '+shown+' ยท '+transferRate(file.size,response.elapsed);
  await info();
  if(kind==='file'||path==={book:'books',font:'fonts',picture:'pictures'}[kind])await loadDirectory();
 }catch(error){++failed;result.textContent=file.name+': '+error.message}}
 if(files.length>1)result.textContent='ฤรฃ lฦฐu '+saved+' tแปp'+(kind==='file'?' vร o /'+destination:'')+(failed?' ยท '+failed+' tแปp lแป—i':'');
 }finally{lock(false)}
}
document.querySelectorAll('.upload').forEach(section=>{
 const input=section.querySelector('input'),result=section.querySelector('.result');
 input.onchange=()=>{result.textContent=[...input.files].map(file=>file.name+' ยท '+size(file.size)).join(' / ')};
 section.ondragover=event=>{event.preventDefault();if(!busy)section.classList.toggle('dragging',true)};
 section.ondragleave=()=>section.classList.toggle('dragging',false);
 section.ondrop=event=>{
  event.preventDefault();section.classList.toggle('dragging',false);
  if(busy||!event.dataTransfer.files.length)return;
  try{input.files=event.dataTransfer.files;input.onchange()}catch(_){result.textContent='Vui lรฒng dรนng nรบt chแปn tแปp cแปงa trรฌnh duyแปt'}
 };
 section.querySelector('.send').onclick=()=>sendFiles(section);
});
info().then(loadDirectory).catch(error=>$('storage').textContent=error.message+', vui lรฒng tแบฃi lแบกi trang');
