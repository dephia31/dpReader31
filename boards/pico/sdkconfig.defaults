# 本板独有的 SDK 配置，追加在根 sdkconfig.defaults 之后，因此这里优先。
# Board-specific SDK configuration, appended after the shared root file, so values here win.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/pico/partitions.csv"
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
# 显式启用 HPM（AUTO 会因为"依赖具体 flash 型号"报 #warning，-Werror 下编不过）。
# 本机 flash 靠写状态寄存器进入高性能模式，不需要调 dummy cycle，所以关掉 HPM-DC。
CONFIG_SPI_FLASH_HPM_ENA=y
CONFIG_SPI_FLASH_HPM_DC_DISABLE=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Read Pico only serves one browser client and scans nearby access points. The
# high-throughput defaults reserve tens of kilobytes at esp_wifi_init(), which
# can starve the hosted WiFi control path after the reader UI has been used.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
# 控制器只能用内部 RAM——它跑在硬件路径上，读不到 PSRAM。这组值是 CrossMux 在同一块
# 板子上验证过的：BLE_MAX_ACT 是"同时允许几个控制器活动"，扫描与建立连接各占一个，
# 压到 1 会让扫描和连接互相排斥，起不来。文件/图片/壁纸列表等搬进 PSRAM 之后 DIRAM
# 空闲约 148KB，这里不需要再省。
# The controller must stay in internal RAM (it sits on the hardware path and cannot read PSRAM).
# These are the values CrossMux verified on this same board: BLE_MAX_ACT is how many controller
# activities may coexist, scanning and connection setup each take one, and squeezing it to 1 makes
# them mutually exclusive so the stack cannot come up. After the file, image and wallpaper lists
# moved into PSRAM, DIRAM has about 148 KB free, so there is nothing left to economise here.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Read Pico SD"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="MindReset"
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=8192

# RTC 睡眠计时采用更稳定的内部快钟分频；清醒仍用 RTC+高精度计时器。
# Use the steadier divided fast oscillator for RTC; retain RTC+high-resolution time while awake.
CONFIG_RTC_CLK_SRC_INT_RC=n
CONFIG_RTC_CLK_SRC_INT_8MD256=y
CONFIG_RTC_CLK_CAL_CYCLES=8190
CONFIG_LIBC_TIME_SYSCALL_USE_RTC_HRT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
