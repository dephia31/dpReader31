menu "Metalio S31 board configuration"

config READ_PICO_I2C_PORT
    int "I2C controller"
    default 1
    range 0 1

config READ_PICO_I2C_SCL_GPIO
    int "I2C SCL GPIO"
    default 1
    range 0 63

config READ_PICO_I2C_SDA_GPIO
    int "I2C SDA GPIO"
    default 0
    range 0 63

config READ_PICO_I2C_FREQ_HZ
    int "I2C frequency (Hz)"
    default 10000
    range 10000 400000

config READ_PICO_IOE_INT_GPIO
    int "TCA9555 shared interrupt GPIO"
    default 2
    range 0 63

config READ_PICO_TP_INT_GPIO
    int "FT6336U interrupt GPIO"
    default 5
    range 0 63

endmenu
