CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# S31使用独立Flash DIO80、Octal PSRAM200；不套用S3共时钟/HPM规则。
# S31 uses DIO80 flash and Octal200 PSRAM; no S3 MSPI/HPM overrides.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_USE_MALLOC=y
# 渲染线程逐行流式读 PSRAM 里的 framebuffer，cache 越大预取越不容易失效
# 多层 EPUB/PNG 调用留安全余量；大型缓存不得放栈上。/ Reserve nested EPUB/PNG stack headroom; keep large caches off-stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 独立S31网络：对齐原厂动态TX，不沿用Pico的PSRAM优先/静态TX策略。
# Independent S31 WiFi retains dynamic TX; bounded RX/TCP tuning follows the native S31 iperf example.
# test30: 12 static /32 dynamic RX, BA12 and 32KiB TCP receive window; reserve RAM for EPD/BLE.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=12
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙翻页器：BLE HID 主机（central），配对市面上的 BLE 翻页器／键盘。
# Bluetooth page-turner: a BLE HID host (central) pairing off-the-shelf BLE remotes.
#
# 本阅读器启用S31的NimBLE central，仅接受BLE HID翻页器。
# This reader enables the S31 NimBLE central for BLE HID remotes.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# host 的全部动态分配走 PSRAM，内部 RAM 留给面板 DMA 与显示。
# The host allocates from PSRAM, leaving internal RAM to the panel DMA and the display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 只做 central；用不到的角色连缓冲一起编掉。
# Central only; the unused roles and their buffers are compiled out.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# bond 密钥必须落 NVS，否则每次重启都要重新配对，自动重连形同虚设。这项默认是 n。
# Bond keys must reach NVS, or every reboot re-pairs and auto-reconnect is useless. Defaults to n.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
# S31控制器采用本SDK原生默认值，不保留S3的BLE_MAX_ACT配置。
# Use native S31 controller settings rather than S3 BLE_MAX_ACT.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BLE_MESH=n

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_300=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_metalio.csv"
CONFIG_READ_PICO_I2C_FREQ_HZ=100000
CONFIG_READ_PICO_I2C_PORT=1
CONFIG_READ_PICO_I2C_SDA_GPIO=0
CONFIG_READ_PICO_I2C_SCL_GPIO=1
CONFIG_READ_PICO_IOE_INT_GPIO=2
CONFIG_READ_PICO_TP_INT_GPIO=5
CONFIG_TINYUSB_DESC_PRODUCT_STRING="kiikoread Metalio S31"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="kiikoread"


# CONFIG_LWIP_SNTP_STARTUP_DELAY is not set

# S31 PR28: full report bring-up uses the author-validated 8192-byte NimBLE host stack.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

CONFIG_LWIP_TCP_WND_DEFAULT=32768

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384

CONFIG_LWIP_TCP_RECVMBOX_SIZE=24

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48
