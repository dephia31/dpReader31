# 两板共用的 SDK 配置。板级覆盖在 boards/<板名>/sdkconfig.defaults，追加在本文件之后，
# 因此板级值优先；两块板各自还有独立的 sdkconfig.<板名>，避免互相改写。
# SDK configuration shared by both boards. boards/<name>/sdkconfig.defaults is appended after
# this file and therefore wins; each board also keeps its own sdkconfig.<name> so the two never
# rewrite each other's configuration.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 实验性组合：MSPI 的 flash 与 PSRAM 共用时钟域，CPU 240MHz 下 IDF 只标定了
# 模块时钟 120MHz，所以 PSRAM 想上 120MHz，flash 必须一起 120MHz。
# 渲染线程逐行读 PSRAM 里的 framebuffer，80MHz 时的实效带宽（约 32MB/s）
# 就是刷新速度的天花板。flash 侧靠 main/flash_hpm_zb.c 补上本机型号的高性能模式。
# 已知风险：上电后温度漂移约 20℃ 会让 PSRAM 访问随机出错。IDF 的温度补偿
# （SPIRAM_TIMING_TUNING_POINT_VIA_TEMPERATURE_SENSOR）只对 flash vendor
# 0xC8/0x20 验证过，本机是 ZB25VQ128(Zbit)，开了会在 do_system_init_fn 里报
# 「flash model has not been verified」直接 abort 并循环重启，所以必须关掉，
# 等于没有这层保护。别改成 y。
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_USE_MALLOC=y
# 多层 EPUB/PNG 调用留安全余量；大型缓存不得放栈上。/ Reserve nested EPUB/PNG stack headroom; keep large caches off-stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1ms tick：EPD 上电流程里按毫秒轮询 PGOOD，100Hz 的 tick 会把每次等待放大到 10ms
CONFIG_FREERTOS_HZ=1000
# 长文件名以 UTF-8 交给界面与 fopen；磁盘 LFN 保持 UTF-16，不需要增加 CP936 表。
# Pass long filenames to UI and fopen as UTF-8; on-disk LFN stays UTF-16 without a CP936 table.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# 传书热点；优先把网络缓冲放PSRAM，避免占用显示所需内部内存。
# Transfer AP prefers PSRAM network buffers, preserving internal display memory.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# 蓝牙翻页器：BLE HID 主机（central），配对市面上的 BLE 翻页器／键盘。
# Bluetooth page-turner: a BLE HID host (central) pairing off-the-shelf BLE remotes.
#
# 只用 BLE。ESP32-S3 没有 Bluetooth Classic 射频，纯 Classic 的翻页器连不上。
# BLE only. The ESP32-S3 has no Bluetooth Classic radio, so Classic-only remotes cannot pair.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# host 的全部动态分配走 PSRAM，内部 RAM 留给面板 DMA 与显示。
# The host allocates from PSRAM, leaving internal RAM to the panel DMA and the display.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# 只做 central；用不到的角色连缓冲一起编掉。
# Central only; the unused roles and their buffers are compiled out.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
# bond 密钥必须落 NVS，否则每次重启都要重新配对，自动重连形同虚设。这项默认是 n。
# Bond keys must reach NVS, or every reboot re-pairs and auto-reconnect is useless. Defaults to n.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=23
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=4
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BLE_MESH=n

CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# rc76: keep transfer listings and TLS allocations out of internal task RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 建立链路的回调链跑在 NimBLE 任务上，通知解析里 4096 字节会触到栈上限。
# The bring-up callback chain runs on the NimBLE task; 4096 bytes reaches its limit inside report parsing.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
