menu "dpReader data protection"
    config DPREADER_AUTO_BACKUP
        bool "Enable automatic SD backup support"
        default y
        depends on IDF_TARGET_ESP32S31 && SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
        help
            Builds the Backup/Restore switch, enabled by default until the user
            saves an off preference. Saves only before Sleep and firmware updates.
            No new task is created. Peak internal SRAM requires device measurement.
            Backup data and stream buffers use PSRAM exclusively on S31.
    config DPREADER_AUTO_RESTORE
        bool "Enable device-bound automatic recovery after peak-SRAM validation"
        default n
        depends on DPREADER_AUTO_BACKUP
        help
            Attempt recovery once at boot only after known settings-namespace loss.
            Requires a V26 backup bound to this device. Interrupted/failed attempts
            remain blocked until explicit manual recovery; no erase or reboot loop.
endmenu
