# Cấu hình cố định duy nhất cho phần cứng Metalio E-ink 4 Plus (metalio47 / ESP32-S31) - dpReader.
get_filename_component(DPREADER_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED DPREADER_BOARD)
    if(DEFINED ENV{DPREADER_BOARD} AND NOT "$ENV{DPREADER_BOARD}" STREQUAL "")
        set(DPREADER_BOARD "$ENV{DPREADER_BOARD}")
    else()
        set(DPREADER_BOARD "metalio47")
    endif()
endif()
if(DPREADER_BOARD STREQUAL "metalio_s31" OR DPREADER_BOARD STREQUAL "metalio4.7" OR DPREADER_BOARD STREQUAL "dpReader_metalio47")
    set(DPREADER_BOARD "metalio47")
endif()
if(NOT DPREADER_BOARD STREQUAL "metalio47")
    message(FATAL_ERROR "dpReader is isolated exclusively for metalio47 (received DPREADER_BOARD=${DPREADER_BOARD})")
endif()
set(DPREADER_BOARD_ROOT "${DPREADER_SOURCE_ROOT}/boards/${DPREADER_BOARD}")
include("${DPREADER_BOARD_ROOT}/board.cmake")
set(DPREADER_BOARD_METALIO47 1)

# 组件需求扫描也会独立加载本文件，不在这里修改工具链。/ Requirement discovery loads this file separately; never change its toolchain here.
function(dpreader_board_sources output component_dir)
    set(selected_sources)
    foreach(source IN LISTS ARGN)
        get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${component_dir}")
        file(RELATIVE_PATH relative "${DPREADER_SOURCE_ROOT}" "${original}")
        set(selected "${DPREADER_BOARD_ROOT}/src/${relative}")
        if(EXISTS "${selected}")
            get_filename_component(original_dir "${original}" DIRECTORY)
            if(NOT CMAKE_SCRIPT_MODE_FILE)
                set_source_files_properties("${selected}" PROPERTIES INCLUDE_DIRECTORIES "${original_dir}")
            endif()
            list(APPEND selected_sources "${selected}")
        else()
            if(relative STREQUAL "main/apps/app_book_picker.c")
                set(owned "${DPREADER_SOURCE_ROOT}/firmware/love_book/apps/app_book_picker.c")
            elseif(relative STREQUAL "main/book/book_lock_collage.c")
                if(DPREADER_EDITION STREQUAL "love-book")
                    set(owned "${DPREADER_SOURCE_ROOT}/firmware/love_book/no_library.c")
                else()
                    set(owned "${DPREADER_SOURCE_ROOT}/firmware/full/library/book_lock_collage.c")
                endif()
            else()
                set(owned "${DPREADER_SOURCE_ROOT}/firmware/shared/${relative}")
            endif()
            if(EXISTS "${owned}")
                list(APPEND selected_sources "${owned}")
            else()
                list(APPEND selected_sources "${source}")
            endif()
        endif()
    endforeach()
    set(${output} "${selected_sources}" PARENT_SCOPE)
endfunction()
