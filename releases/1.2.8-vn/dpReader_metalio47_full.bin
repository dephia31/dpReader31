<section id="signatureSettings"><h2>Chá»¯ kÃ½ thanh tráº¡ng thÃ¡i</h2><p class="hint">Hiá»ƒn thá»‹ á»Ÿ chÃ­nh giá»¯a phÃ­a trÃªn mÃ n hÃ¬nh E-ink. Äá»ƒ trá»‘ng vÃ  lÆ°u náº¿u muá»‘n áº©n.</p><input id="signatureText" type="text" maxlength="95" aria-label="Chá»¯ kÃ½ thanh tráº¡ng thÃ¡i" placeholder="Nháº­p chá»¯ kÃ½ cá»§a báº¡n"><button id="signatureSave" class="primary" type="button">LÆ°u chá»¯ kÃ½</button><p id="signatureResult" class="result" role="status">Äang Ä‘á»c chá»¯ kÃ½â€¦</p></section>
</div>
</main>
<dialog id="editor"><h2 id="editorTitle"></h2><p id="editorDescription"></p><input id="editorName" type="text" maxlength="238" aria-label="TÃªn má»›i"><div class="dialog-actions"><button id="editorCancel" type="button">Há»§y</button><button id="editorConfirm" class="primary" type="button">XÃ¡c nháº­n</button></div></dialog>
<script>
const $=id=>document.getElementById(id);
let policy=null,busy=false,path='',page=0,pages=0,editorAction=null;
const portalTabs=Array.from(document.querySelectorAll('[role="tab"]'));
function selectPortalTab(tab,focus=false){
 if(busy||!portalTabs.includes(tab))return;
 for(const item of portalTabs){const active=item===tab;item.setAttribute('aria-selected',String(active));item.tabIndex=active?0:-1;$(item.getAttribute('aria-controls')).hidden=!active}
 if(focus)tab.focus();
}
portalTabs.forEach((tab,index)=>{
 tab.onclick=()=>selectPortalTab(tab);
 tab.onkeydown=event=>{
  let next;
  if(event.key==='ArrowRight')next=(index+1)%portalTabs.length;
  else if(event.key==='ArrowLeft')next=(index+portalTabs.length-1)%portalTabs.length;
  else if(event.key==='Home')next=0;
  else if(event.key==='End')next=portalTabs.length-1;
  else return;
  event.preventDefault();selectPortalTab(portalTabs[next],true);
 };
});
const size=n=>n>=1048576?(n/1048576).toFixed(1)+' MB':n>=1024?Math.ceil(n/1024)+' KB':n+' B';
const join=(dir,name)=>dir?dir+'/'+name:name;
async function request(url,options){const response=await fetch(url,{cache:'no-store',...options});let body;try{body=await response.json()}catch{throw Error('Pháº£n há»“i tá»« thiáº¿t bá»‹ khÃ´ng há»£p lá»‡, vui lÃ²ng thá»­ láº¡i')}return {status:response.status,body}}
function lock(value){busy=value;document.querySelectorAll('button,input[type=file],input[type=range],#dictionaryName,#signatureText,#kosyncUrl,#kosyncUser,#kosyncPass,#kosyncAuto,#opdsUrl,#opdsUser,#opdsPass').forEach(el=>{if(el.id!=='editorCancel')el.disabled=value});if(!value){$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages;$('wallpaperSend').disabled=!cropImage}}
async function info(){const r=await request('/info');if(r.status!==200)throw Error(r.body.error||'KhÃ´ng thá»ƒ Ä‘á»c tráº¡ng thÃ¡i lÆ°u trá»¯');policy=r.body;$('storage').textContent=(policy.is_flash?'ChÆ°a nháº­n tháº» nhá»› TF':'Tháº» nhá»› TF sáºµn sÃ ng')+' Â· CÃ²n trá»‘ng '+size(policy.free_bytes);if(policy.is_flash){$('browser').hidden=true;$('dictionaryUpload').hidden=true;document.querySelectorAll('.upload').forEach(el=>el.hidden=true);$('storage').textContent='KhÃ´ng phÃ¡t hiá»‡n tháº» nhá»› TF, vui lÃ²ng láº¯p tháº» nhá»› rá»“i má»Ÿ láº¡i trang truyá»n dá»¯ liá»‡u'}}
async function loadDirectory(){if(policy.is_flash)return;const r=await request('/files?'+(path?'path='+encodeURIComponent(path)+'&':'')+'page='+page);if(r.status!==200)throw Error(r.body.error||'KhÃ´ng thá»ƒ Ä‘á»c thÆ° má»¥c');pages=r.body.pages;if(page>=pages&&page){page=0;return loadDirectory()}$('path').textContent='/'+path;$('listState').textContent=r.body.total+' má»¥c';$('pageState').textContent=(pages?page+1:0)+' / '+pages;$('entries').replaceChildren();for(const item of r.body.items){const row=document.createElement('li'),name=document.createElement('div'),actions=document.createElement('div'),detail=document.createElement('small');name.className='entry-name';actions.className='entry-actions';detail.textContent=item.directory?'ThÆ° má»¥c':size(item.size);if(item.directory){const open=document.createElement('button');open.className='folder';open.textContent='â–±  '+item.name;open.onclick=()=>{path=join(path,item.name);page=0;loadDirectory().catch(showError)};name.append(open)}else{name.textContent=item.name}name.append(detail);for(const action of ['rename','copy','delete']){const button=document.createElement('button');button.className='tiny'+(action==='delete'?' danger':'');button.textContent={rename:'Äá»•i tÃªn',copy:'NhÃ¢n báº£n',delete:'XÃ³a'}[action];button.onclick=()=>openEditor(action,item);actions.append(button)}if(!item.directory){const download=document.createElement('a');download.className='download tiny';download.textContent='Táº£i xuá»‘ng';download.href='/download?path='+encodeURIComponent(join(path,item.name));download.download=item.name;actions.append(download)}row.append(name,actions);$('entries').append(row)}$('up').disabled=!path;$('previous').disabled=page<=0;$('next').disabled=page+1>=pages}
function showError(error){$('listState').textContent=error.message||String(error)}
function openEditor(action,item){if(busy)return;const source=item?join(path,item.name):path;editorAction={action,source,item};$('editorTitle').textContent={rename:'Äá»•i tÃªn',copy:'NhÃ¢n báº£n',delete:'XÃ³a',mkdir:'Táº¡o thÆ° má»¥c má»›i'}[action];$('editorDescription').textContent=action==='delete'?source+(item.directory?' (sáº½ xÃ³a toÃ n bá»™ tá»‡p bÃªn trong)':''):'Vá»‹ trÃ­: /'+path;$('editorName').hidden=action==='delete';$('editorName').value=action==='copy'?(item.directory?item.name+' (Báº£n sao)':item.name.replace(/(\.[^.]+)?$/,' (Báº£n sao)$1')):item?item.name:'';$('editorConfirm').textContent=action==='delete'?'XÃ¡c nháº­n xÃ³a':'LÆ°u';$('editorConfirm').classList.toggle('danger',action==='delete');$('editor').showModal();if(action!=='delete')$('editorName').focus()}
$('editorCancel').onclick=()=>$('editor').close();
$('editorConfirm').onclick=async()=>{if(!editorAction)return;const {action,source}=editorAction;const name=$('editorName').value.trim();if(action!=='delete'&&(!name||name==='.'||name==='..'||/[\\/:*?"<>|]/.test(name))){$('editorDescription').textContent='TÃªn khÃ´ng Ä‘Æ°á»£c chá»©a dáº¥u gáº¡ch chÃ©o hoáº·c kÃ½ tá»± Ä‘áº·c biá»‡t';return}const target=action==='delete'?'':join(path,name);if(action!=='delete'&&new TextEncoder().encode(target).length>238){$('editorDescription').textContent='ÄÆ°á»ng dáº«n quÃ¡ dÃ i, vui lÃ²ng rÃºt ngáº¯n tÃªn';return}const payload={action,path:source,...(action==='delete'?{}:{target})};$('editorConfirm').disabled=true;try{const r=await request('/files',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(r.status!==200)throw Error(r.body.error||'Thao tÃ¡c tháº¥t báº¡i');$('editor').close();await info();await loadDirectory()}catch(error){$('editorDescription').textContent=error.message}finally{$('editorConfirm').disabled=false}};
$('refresh').onclick=()=>loadDirectory().catch(showError);
$('up').onclick=()=>{if(!path)return;path=path.includes('/')?path.slice(0,path.lastIndexOf('/')):'';page=0;loadDirectory().catch(showError)};
$('newFolder').onclick=()=>openEditor('mkdir');
$('previous').onclick=()=>{if(page){--page;loadDirectory().catch(showError)}};
$('next').onclick=()=>{if(page+1<pages){++page;loadDirectory().catch(showError)}};
async function loadSyncConfig(){const r=await request('/sync-config');if(r.status!==200)throw Error(r.body.error||'KhÃ´ng thá»ƒ Ä‘á»c cáº¥u hÃ¬nh KOSync/OPDS');$('kosyncUrl').value=r.body.kosync_url||'https://sync.vreader.cloud';$('kosyncUser').value=r.body.kosync_user||'';$('kosyncPass').value='';$('kosyncAuto').checked=!!r.body.kosync_auto;$('opdsUrl').value=r.body.opds_url||'https://sach.vreader.cloud:8443/opds';$('opdsUser').value=r.body.opds_user||'';$('opdsPass').value='';$('syncResult').textContent='Sáºµn sÃ ng chá»‰nh sá»­a cáº¥u hÃ¬nh KOSync & OPDS'}
$('syncSave').onclick=async()=>{if(busy)return;const result=$('syncResult');lock(true);try{result.textContent='Äang lÆ°u cáº¥u hÃ¬nhâ€¦';const payload={kosync_url:$('kosyncUrl').value.trim(),kosync_user:$('kosyncUser').value.trim(),kosync_pass:$('kosyncPass').value,kosync_auto:$('kosyncAuto').checked?1:0,opds_url:$('opdsUrl').value.trim(),opds_user:$('opdsUser').value.trim(),opds_pass:$('opdsPass').value};const r=await request('/sync-config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(r.status!==200)throw Error(r.body.error||'LÆ°u cáº¥u hÃ¬nh tháº¥t báº¡i');$('kosyncPass').value='';$('opdsPass').value='';result.textContent='ÄÃ£ lÆ°u cáº¥u hÃ¬nh KOSync & OPDS thÃ nh cÃ´ng'}catch(error){result.textContent=error.message}finally{lock(false)}};
loadSyncConfig().catch(error=>$('syncResult').textContent=error.message);
async function loadSignature(){const r=await request('/signature');if(r.status!==200)throw Error(r.body.error||'KhÃ´ng thá»ƒ Ä‘á»c chá»¯ kÃ½');$('signatureText').value=r.body.signature||'';$('signatureResult').textContent='CÃ³ thá»ƒ chá»‰nh sá»­a vÃ  lÆ°u chá»¯ kÃ½'}
$('signatureSave').onclick=async()=>{if(busy)return;const text=$('signatureText').value,result=$('signatureResult');if(new TextEncoder().encode(text).length>95){result.textContent='Chá»¯ kÃ½ quÃ¡ dÃ i (tá»‘i Ä‘a 95 byte)';return}if(/[\x00-\x1f\x7f\u2028\u2029]/.test(text)){result.textContent='Chá»¯ kÃ½ khÃ´ng Ä‘Æ°á»£c chá»©a kÃ½ tá»± xuá»‘ng dÃ²ng';return}lock(true);try{result.textContent='Äang lÆ°uâ€¦';const r=await request('/signature',{method:'POST',headers:{'Content-Type':'text/plain; charset=utf-8'},body:text});if(r.status!==200)throw Error(r.body.error||'LÆ°u tháº¥t báº¡i');result.textContent=text?'ÄÃ£ lÆ°u chá»¯ kÃ½ lÃªn thanh tráº¡ng thÃ¡i dpReader':'ÄÃ£ xÃ³a chá»¯ kÃ½'}catch(error){result.textContent=error.message}finally{lock(false)}};
loadSignature().catch(error=>$('signatureResult').textContent=error.message);
function dictionaryPlan(files,folderName){
 const planned=[],groups=new Map(),seen=new Set();
 const validPart=part=>part&&part!=='.'&&part!=='..'&&!/[\\/:*?"<>|\x00-\x1f]/.test(part)&&!/[. ]$/.test(part)&&!part.startsWith('.');
 for(const file of files){
  const relative=file.webkitRelativePath||join(folderName,file.name),parts=relative.split('/');
  if(parts[0]==='dict')parts.shift();
  if(!/\.(ifo|idx(?:\.gz)?|dict(?:\.dz)?|syn)$/.test(file.name))continue;
  if(parts.length!==2||parts.some(part=>!validPart(part)))throw Error('Má»—i bá»™ cáº§n má»™t folder trá»±c tiáº¿p trong dict; tÃªn khÃ´ng Ä‘Æ°á»£c chá»©a Ä‘Æ°á»ng dáº«n láº¡');
  const target='dict/'+parts.join('/');
  if(new TextEncoder().encode(target).length>238)throw Error('ÄÆ°á»ng dáº«n bá»™ tá»« Ä‘iá»ƒn quÃ¡ dÃ i');
  if(!file.size)throw Error('Tá»‡p tá»« Ä‘iá»ƒn rá»—ng: '+file.name);
  const folded=target.toLowerCase();if(seen.has(folded))throw Error('Tá»‡p bá»‹ trÃ¹ng tÃªn: '+file.name);seen.add(folded);
  const suffix=file.name.match(/\.(ifo|idx(?:\.gz)?|dict(?:\.dz)?|syn)$/)[1];
  const base=parts[0]+'/'+file.name.slice(0,-suffix.length-1);
  if(!groups.has(base))groups.set(base,new Set());groups.get(base).add(suffix.split('.')[0]);
  planned.push({file,target,folder:'dict/'+parts[0]});
 }
 if(!planned.length)throw Error('Vui lÃ²ng chá»n folder hoáº·c Ä‘á»§ bá»™ tá»‡p StarDict');
 for(const [base,types] of groups)if(!['ifo','idx','dict'].every(type=>types.has(type)))throw Error('Thiáº¿u bá»™ ba .ifo + .idx/.idx.gz + .dict/.dict.dz: '+base);
 return planned;
}
async function ensureDictionaryFolder(target){
 const parent=target.includes('/')?target.slice(0,target.lastIndexOf('/')):'';
 const r=await request('/files',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'mkdir',path:parent,target})});
 if(r.status===200)return;
 if(r.status===409){const check=await request('/files?path='+encodeURIComponent(target)+'&page=0');if(check.status===200)return;}
 throw Error(r.body.error||'KhÃ´ng táº¡o Ä‘Æ°á»£c thÆ° má»¥c '+target);
}
$('dictionaryFolder').onchange=()=>{$('dictionaryFiles').value=''};
$('dictionaryFiles').onchange=()=>{$('dictionaryFolder').value=''};
$('dictionaryBrowse').onclick=async()=>{if(busy)return;try{await ensureDictionaryFolder('dict');path='dict';page=0;selectPortalTab($('tab-files'));await loadDirectory()}catch(error){$('dictionaryResult').textContent=error.message}};
$('dictionarySend').onclick=async()=>{
 if(busy)return;const result=$('dictionaryResult');
 if(!policy||policy.is_flash){result.textContent='Vui lÃ²ng gáº¯n tháº» nhá»› TF trÆ°á»›c';return}
 let planned;try{const files=$('dictionaryFolder').files.length?[...$('dictionaryFolder').files]:[...$('dictionaryFiles').files];planned=dictionaryPlan(files,$('dictionaryName').value.trim());if(planned.reduce((sum,item)=>sum+item.file.size,0)>policy.free_bytes)throw Error('Tháº» nhá»› TF khÃ´ng Ä‘á»§ dung lÆ°á»£ng trá»‘ng')}catch(error){result.textContent=error.message;return}
 lock(true);let saved=0;
 try{
  await ensureDictionaryFolder('dict');
  for(const folder of new Set(planned.map(item=>item.folder)))await ensureDictionaryFolder(folder);
  // Publish metadata last so an interrupted fresh upload is not offered as a complete dictionary.
  planned.sort((a,b)=>Number(a.target.endsWith('.ifo'))-Number(b.target.endsWith('.ifo')));
  for(const {file,target} of planned){
   const url='/file-upload?path='+encodeURIComponent(target);
   let response=await upload(file,url,(done,total,elapsed)=>result.textContent=uploadProgress('/'+target,done,total,elapsed));
   if(response.status===409&&confirm('Tá»‡p tá»« Ä‘iá»ƒn Ä‘Ã£ tá»“n táº¡i, ghi Ä‘Ã¨?\n/'+target))response=await upload(file,url+'&overwrite=1',(done,total,elapsed)=>result.textContent=uploadProgress('/'+target,done,total,elapsed));
   if(response.status!==200)throw Error(response.body.error||'KhÃ´ng táº£i Ä‘Æ°á»£c '+file.name);
   ++saved;
  }
  result.textContent='ÄÃ£ lÆ°u '+saved+' tá»‡p trong /dict. CÃ³ thá»ƒ má»Ÿ sÃ¡ch Ä‘á»ƒ tra offline.';
  await info();if(path==='dict'||path.startsWith('dict/'))await loadDirectory();
 }catch(error){result.textContent='ÄÃ£ lÆ°u '+saved+'/'+planned.length+' tá»‡p Â· '+error.message+' Â· Chá»n láº¡i Ä‘á»§ bá»™ Ä‘á»ƒ thá»­ láº¡i'}finally{lock(false)}
};
function transferRate(bytes,elapsed){const seconds=Math.max(elapsed,1)/1000;return (bytes/seconds/1000).toFixed(0)+' KB/s Â· '+seconds.toFixed(1)+' giÃ¢y'}
function uploadProgress(name,done,total,elapsed){return (done>=total?'Äang chá» thiáº¿t bá»‹ lÆ°u ':'Äang táº£i lÃªn ')+name+' Â· '+size(done)+' / '+size(total)+' Â· '+transferRate(done,elapsed)}
function upload(file,url,onProgress){return new Promise((resolve,reject)=>{
 const xhr=new XMLHttpRequest();xhr.open('PUT',url);
 const start=performance.now();let loaded=0,total=file.size;
 const paint=()=>onProgress(loaded,total,performance.now()-start);
 const timer=setInterval(paint,1000);
 xhr.upload.onprogress=e=>{loaded=e.loaded;total=e.total||file.size;paint()};
 xhr.onload=()=>{clearInterval(timer);try{resolve({status:xhr.status,body:JSON.parse(xhr.responseText),elapsed:performance.now()-start})}catch{reject(Error('Pháº£n há»“i khÃ´ng há»£p lá»‡, vui lÃ²ng kiá»ƒm tra xem tá»‡p Ä‘Ã£ Ä‘Æ°á»£c lÆ°u chÆ°a'))}};
 xhr.onerror=()=>{clearInterval(timer);reject(Error('Máº¥t káº¿t ná»‘i, vui lÃ²ng giá»¯ mÃ n hÃ¬nh truyá»n dá»¯ liá»‡u trÃªn mÃ¡y vÃ  kiá»ƒm tra Wi-Fi'))};
 xhr.onabort=()=>{clearInterval(timer);reject(Error('ÄÃ£ há»§y táº£i lÃªn'))};
 try{xhr.send(file)}catch(error){clearInterval(timer);reject(error)}
})}
const types={file:{re:null,url:'/file-upload',limit:0},book:{re:/\.(epub|txt)$/i,url:'/upload',limit:0},font:{re:/\.(ttf|otf)$/i,url:'/font-upload',limit:33554432},picture:{re:/\.(jpg|jpeg|png)$/i,url:'/image-upload',limit:20971520}};
const cropWidth=684,cropHeight=1216;
let cropImage=null,cropZoom=1,cropX=0,cropY=0,cropPointer=null;
function cropScale(){return cropImage?Math.max(cropWidth/cropImage.naturalWidth,cropHeight/cropImage.naturalHeight)*cropZoom:1}
function clampCrop(){if(!cropImage)return;const width=cropImage.naturalWidth*cropScale(),height=cropImage.naturalHeight*cropScale();cropX=Math.min(0,Math.max(cropWidth-width,cropX));cropY=Math.min(0,Math.max(cropHeight-height,cropY))}
function drawCrop(canvas){const ctx=canvas.getContext('2d');ctx.setTransform(canvas.width/cropWidth,0,0,canvas.height/cropHeight,0,0);ctx.fillStyle='#f4f4f2';ctx.fillRect(0,0,cropWidth,cropHeight);if(cropImage)ctx.drawImage(cropImage,cropX,cropY,cropImage.naturalWidth*cropScale(),cropImage.naturalHeight*cropScale());else{ctx.fillStyle='#777d77';ctx.font='32px sans-serif';ctx.textAlign='center';ctx.fillText('684 Ã— 1216',cropWidth/2,cropHeight/2)}}
function resetCrop(){if(!cropImage)return;cropZoom=1;$('cropZoom').value='1';cropX=(cropWidth-cropImage.naturalWidth*cropScale())/2;cropY=(cropHeight-cropImage.naturalHeight*cropScale())/2;clampCrop();drawCrop($('cropPreview'))}
$('wallpaperFile').onchange=()=>{const file=$('wallpaperFile').files[0];cropImage=null;$('wallpaperSend').disabled=true;if(!file){drawCrop($('cropPreview'));return}const url=URL.createObjectURL(file),image=new Image();$('wallpaperResult').textContent='Äang Ä‘á»c áº£nhâ€¦';image.onload=()=>{URL.revokeObjectURL(url);if(!image.naturalWidth||!image.naturalHeight){$('wallpaperResult').textContent='KÃ­ch thÆ°á»›c áº£nh khÃ´ng há»£p lá»‡';return}cropImage=image;resetCrop();$('wallpaperSend').disabled=false;$('wallpaperResult').textContent='KÃ©o áº£nh vÃ  chá»‰nh thu phÃ³ng rá»“i nháº¥n táº£i lÃªn'};image.onerror=()=>{URL.revokeObjectURL(url);$('wallpaperResult').textContent='KhÃ´ng thá»ƒ Ä‘á»c áº£nh nÃ y, vui lÃ²ng chá»n áº£nh khÃ¡c'};image.src=url};
$('cropZoom').oninput=()=>{if(!cropImage)return;const next=Number($('cropZoom').value),ratio=next/cropZoom;cropX=cropWidth/2-(cropWidth/2-cropX)*ratio;cropY=cropHeight/2-(cropHeight/2-cropY)*ratio;cropZoom=next;clampCrop();drawCrop($('cropPreview'))};
$('cropReset').onclick=resetCrop;
$('cropPreview').onpointerdown=event=>{if(!cropImage||busy)return;cropPointer={id:event.pointerId,x:event.clientX,y:event.clientY};$('cropPreview').setPointerCapture(event.pointerId)};
$('cropPreview').onpointermove=event=>{if(!cropPointer||cropPointer.id!==event.pointerId)return;const ratio=cropWidth/$('cropPreview').getBoundingClientRect().width;cropX+=(event.clientX-cropPointer.x)*ratio;cropY+=(event.clientY-cropPointer.y)*ratio;cropPointer.x=event.clientX;cropPointer.y=event.clientY;clampCrop();drawCrop($('cropPreview'))};
$('cropPreview').onpointerup=$('cropPreview').onpointercancel=()=>{cropPointer=null};
$('wallpaperSend').onclick=async()=>{if(!cropImage||busy)return;const result=$('wallpaperResult');if(!policy||policy.is_flash){result.textContent='Thiáº¿t bá»‹ chÆ°a káº¿t ná»‘i hoáº·c tháº» TF chÆ°a sáºµn sÃ ng';return}lock(true);try{result.textContent='Äang táº¡o hÃ¬nh ná»n 684 Ã— 1216â€¦';const canvas=document.createElement('canvas');canvas.width=cropWidth;canvas.height=cropHeight;drawCrop(canvas);let blob=null;for(const quality of [0.86,0.72,0.56,0.42]){blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));if(blob&&blob.size<=2097152)break}if(!blob)throw Error('TrÃ¬nh duyá»‡t khÃ´ng thá»ƒ táº¡o áº£nh cáº¯t');if(blob.size>2097152)throw Error('áº¢nh váº«n quÃ¡ lá»›n, vui lÃ²ng chá»n áº£nh khÃ¡c');if(blob.size>policy.free_bytes)throw Error('Tháº» nhá»› TF khÃ´ng Ä‘á»§ dung lÆ°á»£ng');const name='dpreader-wallpaper-'+Date.now()+'.jpg';const url='/image-upload?name='+encodeURIComponent(name)+'&wallpaper=1';const response=await upload(blob,url,(done,total,elapsed)=>result.textContent=uploadProgress('HÃ¬nh ná»n',done,total,elapsed));if(response.status!==200)throw Error(response.body.error||'Táº£i hÃ¬nh ná»n tháº¥t báº¡i');result.textContent='ÄÃ£ Ä‘áº·t lÃ m hÃ¬nh ná»n mÃ n hÃ¬nh khÃ³a';await info();if(path==='pictures')await loadDirectory()}catch(error){result.textContent=error.message}finally{lock(false)}};
drawCrop($('cropPreview'));
async function sendFiles(section){
 if(busy||!policy||policy.is_flash)return;
 const kind=section.dataset.kind,config=types[kind],files=[...section.querySelector('input').files],result=section.querySelector('.result'),destination=path;
 if(!files.length){result.textContent='Vui lÃ²ng chá»n tá»‡p trÆ°á»›c';return}
 lock(true);
 let saved=0,failed=0;
 try{for(const file of files){try{
  if(config.re&&(!config.re.test(file.name)||file.name.startsWith('.')))throw Error('Äá»‹nh dáº¡ng tá»‡p khÃ´ng há»— trá»£');
  if(kind!=='file'&&!file.size)throw Error('Tá»‡p rá»—ng');
  if((config.limit&&file.size>config.limit)||(kind==='book'&&policy.file_limit&&file.size>policy.file_limit))throw Error('KÃ­ch thÆ°á»›c tá»‡p vÆ°á»£t quÃ¡ giá»›i háº¡n');
  if(file.size>policy.free_bytes)throw Error('Tháº» nhá»› TF khÃ´ng Ä‘á»§ dung lÆ°á»£ng trá»‘ng');
  const target=join(destination,file.name);
  if(kind==='file'&&new TextEncoder().encode(target).length>238)throw Error('ÄÆ°á»ng dáº«n quÃ¡ dÃ i, vui lÃ²ng rÃºt ngáº¯n tÃªn tá»‡p');
  const shown=kind==='file'?'/'+target:file.name;
  result.textContent='Äang táº£i lÃªn '+shown;
  const url=config.url+(kind==='file'?'?path='+encodeURIComponent(target):'?name='+encodeURIComponent(file.name));
  let response=await upload(file,url,(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status===409&&confirm('Tá»‡p cÃ¹ng tÃªn Ä‘Ã£ tá»“n táº¡i, báº¡n cÃ³ muá»‘n ghi Ä‘Ã¨?\n'+shown))response=await upload(file,url+'&overwrite=1',(done,total,elapsed)=>result.textContent=uploadProgress(shown,done,total,elapsed));
  if(response.status!==200)throw Error(response.body.error||'Táº£i lÃªn tháº¥t báº¡i');
  ++saved;result.textContent='ÄÃ£ lÆ°u '+shown+' Â· '+transferRate(file.size,response.elapsed);
  await info();
  if(kind==='file'||path==={book:'books',font:'fonts',picture:'pictures'}[kind])await loadDirectory();
 }catch(error){++failed;result.textContent=file.name+': '+error.message}}
 if(files.length>1)result.textContent='ÄÃ£ lÆ°u '+saved+' tá»‡p'+(kind==='file'?' vÃ o /'+destination:'')+(failed?' Â· '+failed+' tá»‡p lá»—i':'');
 }finally{lock(false)}
}
document.querySelectorAll('.upload').forEach(section=>{
 const input=section.querySelector('input'),result=section.querySelector('.result');
 input.onchange=()=>{result.textContent=[...input.files].map(file=>file.name+' Â· '+size(file.size)).join(' / ')};
 section.ondragover=event=>{event.preventDefault();if(!busy)section.classList.toggle('dragging',true)};
 section.ondragleave=()=>section.classList.toggle('dragging',false);
 section.ondrop=event=>{
  event.preventDefault();section.classList.toggle('dragging',false);
  if(busy||!event.dataTransfer.files.length)return;
  try{input.files=event.dataTransfer.files;input.onchange()}catch(_){result.textContent='Vui lÃ²ng dÃ¹ng nÃºt chá»n tá»‡p cá»§a trÃ¬nh duyá»‡t'}
 };
 section.querySelector('.send').onclick=()=>sendFiles(section);
});
info().then(loadDirectory).catch(error=>$('storage').textContent=error.message+', vui lÃ²ng táº£i láº¡i trang');
</script>
</html>
